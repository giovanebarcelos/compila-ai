<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.ulife</groupId>
    <artifactId>Compilador</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <antlr.version>4.13.2</antlr.version>
        <cup.version>11b-20160615</cup.version>
    </properties>

    <dependencies>
        <!-- ANTLR completo (runtime + org.antlr.v4.gui.TreeViewer + Tool) -->
        <dependency>
            <groupId>org.antlr</groupId>
            <artifactId>antlr4</artifactId>
            <version>${antlr.version}</version>
        </dependency>
        <!-- Runtime do Java CUP (java_cup.runtime.*) -->
        <dependency>
            <groupId>com.github.vbmacher</groupId>
            <artifactId>java-cup-runtime</artifactId>
            <version>${cup.version}</version>
        </dependency>
    </dependencies>

    <build>
        <!-- código comum -->
        <sourceDirectory>src/main/lib</sourceDirectory>

        <plugins>
            <!--
              Gera o código de TODAS as gramáticas src/main/antlr/**/*.g4 em
              target/generated-sources/antlr4 (pacote padrão, com listener e visitor).
              Não guarde os .java gerados junto da gramática: dariam classe duplicada.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <dependencies>
                    <dependency>
                        <groupId>org.antlr</groupId>
                        <artifactId>antlr4</artifactId>
                        <version>${antlr.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>gerar-antlr</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <property name="antlr.out" value="${project.build.directory}/generated-sources/antlr4"/>
                                <mkdir dir="${antlr.out}"/>
                                <apply executable="${java.home}/bin/java" parallel="true"
                                       failonerror="true" skipemptyfilesets="true">
                                    <arg value="-cp"/>
                                    <arg pathref="maven.plugin.classpath"/>
                                    <arg value="org.antlr.v4.Tool"/>
                                    <arg value="-o"/>
                                    <arg value="${antlr.out}"/>
                                    <arg value="-lib"/>
                                    <arg value="${antlr.out}"/>
                                    <arg value="-Xexact-output-dir"/>
                                    <arg value="-visitor"/>
                                    <arg value="-encoding"/>
                                    <arg value="UTF-8"/>
                                    <fileset dir="${basedir}/src/main/antlr" includes="**/*.g4"/>
                                </apply>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              Todos os diretórios de exercício são compilados juntos (pacote padrão)
              e vão para target/classes. Por isso os nomes de classe NÃO podem se
              repetir entre os diretórios.
              Ao criar um exercício novo, acrescente o diretório na lista abaixo
              e recarregue o Maven no IntelliJ.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-exercicios</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/main/java</source>
                                <source>${project.build.directory}/generated-sources/antlr4</source>
                                <source>src/main/antlr/1calc</source>
                                <source>src/main/antlr/2calc_variaveis</source>
                                <source>src/main/jflex_cup/1calc</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
            </plugin>
        </plugins>
    </build>

</project>
